# ---- LLMWebChat env (optional; most settings live in the UI / data/settings.json) ----

# Path where the proxy stores settings & data (default: ./data)
LLMWEBCHAT_DATA_DIR=./data

# Server port (default: 8787)
PORT=8787

# Optional bearer token to protect the proxy if you ever bind beyond localhost
# LLMWEBCHAT_AUTH_TOKEN=

# Ollama base URL (default http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434

# Optional keys for built-in providers (set in the UI instead, usually)
# OPENROUTER_API_KEY=
