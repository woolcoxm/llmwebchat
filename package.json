{
  "name": "llmwebchat",
  "version": "0.1.0",
  "private": true,
  "description": "An advanced, provider-agnostic LLM web chat interface — z.ai GLM + local models, full-agentic.",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @llmwebchat/server dev & pnpm --filter @llmwebchat/web dev & wait",
    "dev:server": "pnpm --filter @llmwebchat/server dev",
    "dev:web": "pnpm --filter @llmwebchat/web dev",
    "build": "pnpm -r build",
    "icons": "node scripts/gen-icons.mjs",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "pnpm -r exec rm -rf dist node_modules .turbo"
  },
  "devDependencies": {
    "sharp": "^0.35.3",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=20"
  }
}
